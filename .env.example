# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Cutoff Schedules (HH:MM in 24hr format)
DEFAULT_BREAKFAST_CUTOFF_TIME=06:00
DEFAULT_LUNCH_CUTOFF_TIME=10:00
DEFAULT_DINNER_CUTOFF_TIME=17:00

# Initial Admin Provisioning Credentials
INITIAL_ADMIN_EMAIL=admin@mess.college.edu
INITIAL_ADMIN_PASSWORD=SecureAdminPassword123!
INITIAL_ADMIN_NAME="Mess Head Administrator"
